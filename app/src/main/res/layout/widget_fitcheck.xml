<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="#F7F2E9">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <ImageView android:id="@+id/widget_image_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:scaleType="centerCrop" android:layout_margin="2dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/widget_image_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:layout_margin="2dp" />
            <ImageView android:id="@+id/widget_image_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:layout_margin="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/widget_image_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:layout_margin="2dp" />
            <ImageView android:id="@+id/widget_image_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:layout_margin="2dp" />
            <ImageView android:id="@+id/widget_image_6" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:layout_margin="2dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Everyday" android:textColor="#171717" android:textSize="18sp" android:textStyle="bold" android:paddingTop="5dp" />
</LinearLayout>
